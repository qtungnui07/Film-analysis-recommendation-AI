# Copy to .env and fill in. Every LLM_* value has a working default for the local dev model.

# Any OpenAI-compatible chat completions endpoint
LLM_BASE_URL=http://localhost:3636/v1
LLM_MODEL=google/gemma-4-e2b
LLM_API_KEY=not-needed
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500
LLM_TIMEOUT=120

AGENT_MAX_TOOL_ROUNDS=6
RETRIEVAL_TOP_K=10
RETRIEVAL_MIN_SIMILARITY=0.0
MEMORY_MAX_RECOMMENDATIONS=5
STRICT_UNKNOWN_WARNINGS=false

# DoesTheDogDie API key: topic list for moviebot.build_db, and labels fetched on demand
DTDD_KEY=

# TMDB v3 API key: overviews (moviebot.fetch_overviews) and adding movies that are not in the catalogue
TMDB_KEY=
